// Значок FloV:MP для окна игры и сведения о файле FloVMP.asi.
#include <windows.h>
#pragma code_page(65001)

101 ICON "flovmp.ico"

// Логотип FloV:MP для загрузочного экрана. Зашит в клиент, чтобы экран не
// зависел от файлов рядом: владелец сервера может положить свой, но пустого
// места на месте знака не будет никогда.
102 RCDATA "flovmp-logo.png"

// Фирменные шрифты (Manrope и JetBrains Mono, лицензия OFL) вместо
// системного Segoe UI: интерфейс выглядит одинаково на любой Виндове
// и совпадает с сайтом и лаунчером. Латиница и кириллица лежат
// отдельными подмножествами и склеиваются в атласе ImGui.
110 RCDATA "fonts/manrope-400-latin.ttf"
111 RCDATA "fonts/manrope-400-cyrillic.ttf"
112 RCDATA "fonts/manrope-700-latin.ttf"
113 RCDATA "fonts/manrope-700-cyrillic.ttf"
114 RCDATA "fonts/jbmono-latin.ttf"
115 RCDATA "fonts/jbmono-cyrillic.ttf"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "041904b0"
        BEGIN
            VALUE "CompanyName", "FloV:MP"
            VALUE "FileDescription", "FloV Multiplayer — клиент для GTA V Legacy 1.0.3889.0"
            VALUE "FileVersion", "1.0.0"
            VALUE "InternalName", "FloVMP"
            VALUE "OriginalFilename", "FloVMP.asi"
            VALUE "ProductName", "FloV Multiplayer"
            VALUE "ProductVersion", "1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x419, 1200
    END
END
