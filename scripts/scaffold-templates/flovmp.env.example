# =====================================================================
# FloV:MP Server — Переменные окружения RP проекта
# =====================================================================

# Отображаемое имя проекта (White-Label: подставляется в HUD, Auth, Chat)
FLOVMP_SERVER_NAME=RolePlay Server

# Лицензионный ключ проекта
FLOVMP_LICENSE_KEY=FLV-DEMO-0000-0000

# Строка подключения к MariaDB / MySQL
FLOVMP_DB_CONNECTION=Server=127.0.0.1;Port=3306;Database=flovmp_rp;Uid=root;Pwd=;

# Игровые порты
FLOVMP_PORT=7788
FLOVMP_VOICE_PORT=7798
