# Скопируйте в server.txt и впишите адрес вашего сервера перед раздачей папки.
# Установщик создаст игроку ярлык на рабочем столе, play.cmd подключит сразу.
# На Linux install.sh заполняет этот файл сам.
address=
name=FloV:MP
# Моды сервера со своего CDN (mods.public_url сервера). Пусто — берутся с самого
# сервера (порт игры + 20) или по адресу, который сервер сообщит при входе.
mods=
