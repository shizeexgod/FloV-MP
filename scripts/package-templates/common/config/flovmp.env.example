# =====================================================================
#  FloV:MP — настройки сервера (переменные окружения)
#
#  Установщик создаёт из этого шаблона config/flovmp.env и заполняет его сам.
#  Файл содержит пароли: не публикуйте его и не отправляйте в чаты.
#  Формат: КЛЮЧ=значение, без пробелов вокруг «=». Кавычки не обязательны.
#  После правки перезапустите сервер.
# =====================================================================

# --- База данных MariaDB / MySQL -------------------------------------
# Пустой пароль = работа без базы (права и баны хранятся в файлах).
FLOVMP_DB_HOST=127.0.0.1
FLOVMP_DB_PORT=3306
FLOVMP_DB_NAME=flovmp_server
FLOVMP_DB_USER=flovmp
FLOVMP_DB_PASSWORD=

# --- Администрирование ------------------------------------------------
# SocialClubId владельца: всегда уровень 8, даже если в таблице admins его нет.
FLOVMP_OWNER_SC=

# Одноразовый токен для /claimowner <токен> в игре. Действует, пока на
# сервере нет ни одного администратора.
FLOVMP_SETUP_TOKEN=

# Проверка движения игроков на сервере (телепорт, скорость, полёт):
#   log    — только запись в лог (по умолчанию),
#   strict — нарушителя возвращает на последнюю честную позицию,
#   off    — выключить.
# Координаты — единственное, что поддельный клиент не может скрыть, поэтому
# проверка живёт на сервере. Администраторы из неё исключены: у них NoClip.
FLOVMP_ANTICHEAT=log

# Замер времени внутри игрового тика: FLOVMP_PERF=1 включает его сразу при
# старте. Без этого его включает команда «perf on» в консоли сервера, а отчёт
# показывает «perf». Нужен, когда сервер тормозит и надо понять, на чём именно.
FLOVMP_PERF=0

# --- Лицензия ---------------------------------------------------------
# Лицензия — файл license.flv в корне установки (рядом с папками server и
# voice). Скачивается в личном кабинете или установщиком по ключу
# (install.sh --key FLV-...). Локальная подпись проверяется всегда; при наличии
# ключа сервер также получает короткий online lease и видит отзыв из портала.
# Без действующей лицензии вход для всех игроков запрещён, включая админов.
FLOVMP_LICENSE_KEY=
# Можно заменить на свой совместимый backend endpoint.
FLOVMP_LICENSE_VERIFY_URL=https://flovmp.ru/api/v1/license/verify
# Максимальный offline-период без подтверждённого lease (1..168 часов).
FLOVMP_OFFLINE_GRACE_HOURS=24
