<Project>

  <!--
    Общие настройки всех проектов лаунчера FloV:MP.
    net8.0-windows: лаунчер — отдельный процесс, с движком alt:V по TFM не
    связан, но HANDOFF фиксирует .NET 8. Desktop Runtime 8 уже стоит.
    UseWPF включается точечно в FloVMP.Launcher.csproj (Core и Tests без WPF).
  -->
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

</Project>
