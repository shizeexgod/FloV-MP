<Window x:Class="FloVMP.Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:FloVMP.Launcher.ViewModels"
        Title="FloV:MP Launcher" Height="640" Width="560"
        WindowStartupLocation="CenterScreen">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
            <TextBlock Text="FloV" FontSize="26" FontWeight="Bold"/>
            <TextBlock Text=":MP" FontSize="26" FontWeight="Bold" Foreground="{StaticResource Accent}"/>
            <TextBlock Text="  launcher" FontSize="14" Foreground="{StaticResource Text1}" VerticalAlignment="Bottom" Margin="6,0,0,4"/>
        </StackPanel>

        <!-- Сервер -->
        <Border Grid.Row="1" Background="{StaticResource Bg1}" BorderBrush="{StaticResource Stroke}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="СЕРВЕР" Style="{StaticResource Caption}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Text="{Binding ServerHost, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0"/>
                    <TextBox Grid.Column="1" Text="{Binding ServerPortText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0"/>
                    <Button Grid.Column="2" Content="Проверить" Command="{Binding CheckServerCommand}"/>
                </Grid>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Ellipse Width="9" Height="9" Fill="{Binding ServerStatusBrush}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                    <TextBlock Text="{Binding ServerStatusText}" Foreground="{StaticResource Text1}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Игрок -->
        <Border Grid.Row="2" Background="{StaticResource Bg1}" BorderBrush="{StaticResource Stroke}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="НИКНЕЙМ" Style="{StaticResource Caption}"/>
                <TextBox Text="{Binding Nickname, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
        </Border>

        <!-- Пути -->
        <Border Grid.Row="3" Background="{StaticResource Bg1}" BorderBrush="{StaticResource Stroke}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="GTA V" Style="{StaticResource Caption}"/>
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Text="{Binding GtaPath, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0"/>
                    <Button Grid.Column="1" Content="Найти" Command="{Binding DetectGtaCommand}" Margin="0,0,8,0"/>
                    <Button Grid.Column="2" Content="Обзор…" Command="{Binding BrowseGtaCommand}"/>
                </Grid>
                <TextBlock Text="{Binding GtaStatusText}" Foreground="{StaticResource Text1}" FontSize="11" Margin="0,0,0,12"/>

                <TextBlock Text="ЯДРО КЛИЕНТА FloV:MP (папка с flovmp.exe)" Style="{StaticResource Caption}"/>
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Text="{Binding AltvCoreDir, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0"/>
                    <Button Grid.Column="1" Content="Обзор…" Command="{Binding BrowseCoreCommand}"/>
                </Grid>
                <TextBlock Text="{Binding CoreStatusText}" Foreground="{StaticResource Text1}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,12"/>

                <TextBlock Text="ОБНОВЛЕНИЕ ЯДРА ПО МАНИФЕСТУ (URL или путь к manifest.json)" Style="{StaticResource Caption}"/>
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Text="{Binding CoreManifestUrl, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0"/>
                    <Button Grid.Column="1" Content="Проверить / Обновить" Command="{Binding SyncCoreCommand}"/>
                </Grid>
                <ProgressBar Height="6" Minimum="0" Maximum="1" Value="{Binding SyncFraction, Mode=OneWay}"
                             Background="{StaticResource Bg0}" Foreground="{StaticResource Accent}"
                             BorderThickness="0" Margin="0,4,0,4"
                             Visibility="{Binding IsSyncing, Converter={StaticResource BoolToVis}}"/>
                <TextBlock Text="{Binding SyncStatusText}" Foreground="{StaticResource Text1}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,12"/>

                <TextBlock Text="МАНИФЕСТ СОВМЕСТИМОСТИ С ВЕРСИЯМИ GTA V (URL или путь, опционально)" Style="{StaticResource Caption}"/>
                <TextBox Text="{Binding CompatManifestUrl, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
        </Border>

        <!-- Опции -->
        <StackPanel Grid.Row="4" Margin="2,0,0,12">
            <CheckBox Content="Разрешить несколько клиентов (для локального теста)"
                      IsChecked="{Binding AllowMultipleInstances}" Foreground="{StaticResource Text1}" Margin="0,0,0,4"/>
            <CheckBox Content="Синхронизировать глобальный altv.toml перед запуском (делает .bak)"
                      IsChecked="{Binding SyncAltvToml}" Foreground="{StaticResource Text1}"/>
        </StackPanel>

        <!-- Лог -->
        <Border Grid.Row="5" Background="{StaticResource Bg2}" BorderBrush="{StaticResource Stroke}" BorderThickness="1" CornerRadius="8" Padding="2">
            <TextBox Text="{Binding LogText, Mode=OneWay}" IsReadOnly="True" BorderThickness="0"
                     Background="Transparent" FontFamily="Consolas" FontSize="11"
                     VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"/>
        </Border>

        <!-- Играть -->
        <Button Grid.Row="6" Content="ИГРАТЬ" Style="{StaticResource PlayButton}"
                Command="{Binding PlayCommand}" Margin="0,14,0,0" HorizontalAlignment="Stretch"/>
    </Grid>
</Window>
