<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>FloVMP.Launcher.Native</AssemblyName>
    <RootNamespace>FloVMP.Launcher.Native</RootNamespace>
    <AssemblyTitle>FloV:MP Launcher Native Helper</AssemblyTitle>
    <AssemblyDescription>Stdio JSON-мост между Electron-оболочкой и нативной логикой лаунчера (реестр, запуск игры)</AssemblyDescription>
    <Product>Держава RP Launcher Native</Product>
    <Version>1.0.0</Version>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

</Project>
