<Window x:Class="FloridaV.Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:FloridaV.Launcher.ViewModels"
        Title="Florida V Launcher"
        Width="1100" Height="680"
        MinWidth="900" MinHeight="580"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResizeWithGrip">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <!-- Внешняя тень окна -->
    <Window.Effect>
        <DropShadowEffect BlurRadius="30" ShadowDepth="0" Color="#000000" Opacity="0.8"/>
    </Window.Effect>

    <Border Background="{StaticResource Bg0Brush}" CornerRadius="12"
            BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1">
        <Grid>
            <Grid.ColumnDefinitions>
                <!-- Левое меню -->
                <ColumnDefinition Width="220"/>
                <!-- Основная область -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ═══════════════════════════════════════════════════════ -->
            <!-- ЛЕВОЕ БОКОВОЕ МЕНЮ                                     -->
            <!-- ═══════════════════════════════════════════════════════ -->
            <Border Grid.Column="0" Background="{StaticResource SidebarGradient}"
                    CornerRadius="12,0,0,12"
                    BorderBrush="{StaticResource StrokeBrush}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Логотип -->
                    <StackPanel Grid.Row="0" Margin="20,24,20,20" Orientation="Horizontal">
                        <Image Source="../Assets/florida_logo.png" Width="36" Height="36"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Florida V" FontSize="18" FontWeight="Bold"
                                       Foreground="White"/>
                            <TextBlock Text="RolePlay" FontSize="10" Foreground="{StaticResource AccentBrush}"
                                       FontWeight="SemiBold"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Разделитель -->
                    <Rectangle Grid.Row="1" Height="1" Fill="{StaticResource StrokeBrush}" Margin="20,0"/>

                    <!-- Навигация -->
                    <StackPanel Grid.Row="2" Margin="0,16,0,0">
                        <Button Style="{StaticResource NavButton}"
                                Tag="{Binding CurrentPage, Converter={StaticResource PageActiveTag}, ConverterParameter=Play}"
                                Content="🎮  Играть"
                                Command="{Binding NavigatePlayCommand}"/>
                        <Button Style="{StaticResource NavButton}"
                                Tag="{Binding CurrentPage, Converter={StaticResource PageActiveTag}, ConverterParameter=News}"
                                Content="📰  Новости"
                                Command="{Binding NavigateNewsCommand}"/>
                        <Button Style="{StaticResource NavButton}"
                                Tag="{Binding CurrentPage, Converter={StaticResource PageActiveTag}, ConverterParameter=Settings}"
                                Content="⚙  Настройки"
                                Command="{Binding NavigateSettingsCommand}"/>

                        <Rectangle Height="1" Fill="{StaticResource StrokeBrush}" Margin="20,16"/>

                        <Button Style="{StaticResource NavButton}"
                                Content="💬  Discord"
                                Command="{Binding OpenDiscordCommand}"/>
                        <Button Style="{StaticResource NavButton}"
                                Content="📋  Форум"
                                Command="{Binding OpenForumCommand}"/>
                        <Button Style="{StaticResource NavButton}"
                                Content="💰  Донат"
                                Command="{Binding OpenDonateCommand}"/>
                    </StackPanel>

                    <!-- Низ меню: ник + версия -->
                    <StackPanel Grid.Row="3" Margin="20,0,20,20">
                        <Rectangle Height="1" Fill="{StaticResource StrokeBrush}" Margin="0,0,0,14"/>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="32" Height="32" CornerRadius="16"
                                    Background="{StaticResource AccentBrush}">
                                <TextBlock Text="{Binding NicknameInitial}"
                                           FontWeight="Bold" FontSize="14"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Nickname}" FontWeight="SemiBold"
                                           FontSize="13" Foreground="White"/>
                                <TextBlock Text="Игрок" FontSize="10"
                                           Foreground="{StaticResource Text2Brush}"/>
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Text="{Binding VersionText}" FontSize="10"
                                   Foreground="{StaticResource Text2Brush}" Margin="0,10,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ═══════════════════════════════════════════════════════ -->
            <!-- ПРАВАЯ ЧАСТЬ                                           -->
            <!-- ═══════════════════════════════════════════════════════ -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="48"/>   <!-- Тайтл-бар -->
                    <RowDefinition Height="*"/>    <!-- Контент -->
                </Grid.RowDefinitions>

                <!-- ─── Тайтл-бар (drag + управление окном) ─── -->
                <Border Grid.Row="0" Background="Transparent"
                        MouseLeftButtonDown="TitleBar_MouseDown">
                    <Grid>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                    VerticalAlignment="Center" Margin="0,0,12,0">
                            <Button Style="{StaticResource WinControlBtn}" Content="—"
                                    Click="BtnMinimize_Click"/>
                            <Button Style="{StaticResource WinControlBtn}" Content="❐"
                                    Click="BtnMaximize_Click" Margin="4,0"/>
                            <Button Style="{StaticResource CloseBtn}" Content="✕"
                                    Click="BtnClose_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ─── Страница «Играть» ─── -->
                <Grid Grid.Row="1" Margin="24,0,24,24"
                      Visibility="{Binding CurrentPage, Converter={StaticResource PageVis}, ConverterParameter=Play}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="300"/>
                    </Grid.ColumnDefinitions>

                    <!-- Левый блок: Сервер + кнопка ИГРАТЬ -->
                    <Grid Grid.Column="0" Margin="0,0,16,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Карточка сервера с фоновой картинкой -->
                        <Border Grid.Row="0" CornerRadius="10" ClipToBounds="True">
                            <Grid>
                                <!-- Фон — тёмно-городской арт (placeholder — тёмный градиент) -->
                                <Border>
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#1A0A1E" Offset="0"/>
                                            <GradientStop Color="#0A1228" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>

                                <!-- Декоративные розовые линии (неоновый эффект) -->
                                <Canvas>
                                    <Rectangle Canvas.Left="-50" Canvas.Top="80"
                                               Width="300" Height="2" Opacity="0.15"
                                               Fill="{StaticResource AccentBrush}"
                                               RenderTransformOrigin="0,0">
                                        <Rectangle.RenderTransform>
                                            <RotateTransform Angle="-35"/>
                                        </Rectangle.RenderTransform>
                                    </Rectangle>
                                </Canvas>

                                <!-- Нижний градиент для читаемости текста -->
                                <Border VerticalAlignment="Bottom" Height="200" CornerRadius="0,0,10,10">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="Transparent" Offset="0"/>
                                            <GradientStop Color="#CC0A0A10" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>

                                <!-- Контент карточки -->
                                <StackPanel VerticalAlignment="Bottom" Margin="28,28,28,28">
                                    <!-- Онлайн-статус -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                                 Fill="{Binding ServerStatusBrush}" Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding ServerStatusText}"
                                                   Foreground="{StaticResource Text2Brush}" FontSize="12"/>
                                        <TextBlock Text=" • " Foreground="{StaticResource Text2Brush}" FontSize="12"/>
                                        <TextBlock Text="{Binding OnlineText}"
                                                   Foreground="{StaticResource Text2Brush}" FontSize="12"/>
                                    </StackPanel>

                                    <!-- Название сервера -->
                                    <TextBlock Text="Держава RP" FontSize="42" FontWeight="Black"
                                               Foreground="White" Margin="0,0,0,4">
                                        <TextBlock.Effect>
                                            <DropShadowEffect Color="Black" BlurRadius="15"
                                                              ShadowDepth="0" Opacity="0.7"/>
                                        </TextBlock.Effect>
                                    </TextBlock>
                                    <TextBlock Text="Российский ролевой сервер · FloV:MP"
                                               Foreground="{StaticResource Text2Brush}" FontSize="13"
                                               Margin="0,0,0,24"/>

                                    <!-- Прогресс-бар обновления -->
                                    <StackPanel Visibility="{Binding IsUpdating, Converter={StaticResource BoolToVis}}"
                                                Margin="0,0,0,12">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <TextBlock Text="Загрузка FloV:MP: "
                                                       Foreground="{StaticResource Text2Brush}" FontSize="11"/>
                                            <TextBlock Text="{Binding UpdateStatusText}"
                                                       Foreground="{StaticResource AccentBrush}" FontSize="11"/>
                                        </StackPanel>
                                        <ProgressBar Style="{StaticResource DownloadBar}"
                                                     Value="{Binding UpdateProgress}"/>
                                    </StackPanel>

                                    <!-- Кнопка ИГРАТЬ -->
                                    <Button Style="{StaticResource PlayButton}"
                                            Content="{Binding PlayButtonText}"
                                            Command="{Binding PlayAsyncCommand}"/>

                                    <!-- Строка статуса -->
                                    <TextBlock Text="{Binding StatusMessage}"
                                               FontSize="11" TextWrapping="Wrap"
                                               Margin="0,10,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource Text2Brush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasError}" Value="True">
                                                        <Setter Property="Foreground" Value="#FF6B6B"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Правый блок: Новости -->
                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="ПОСЛЕДНИЕ НОВОСТИ"
                                   FontSize="11" FontWeight="Bold" Foreground="{StaticResource Text2Brush}" Margin="0,0,0,12"/>

                        <!-- Лента новостей -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden">
                            <ItemsControl ItemsSource="{Binding NewsItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource Card}" Margin="0,0,0,10"
                                                Cursor="Hand" Padding="14,12">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <TextBlock Grid.Row="0" Text="{Binding Title}"
                                                           FontSize="13" FontWeight="SemiBold"
                                                           TextWrapping="Wrap" Foreground="White"/>
                                                <TextBlock Grid.Row="1" Text="{Binding Date}"
                                                           FontSize="10" Foreground="{StaticResource Text2Brush}"
                                                           Margin="0,6,0,0"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Grid>

                <!-- ─── Страница «Новости» ─── -->
                <Grid Grid.Row="1" Margin="24,0,24,24"
                      Visibility="{Binding CurrentPage, Converter={StaticResource PageVis}, ConverterParameter=News}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="НОВОСТИ" FontSize="20" FontWeight="Bold" Margin="0,0,0,16"/>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding NewsItems}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel MaxWidth="640" HorizontalAlignment="Left"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Card}" Margin="0,0,0,12" Padding="20,16">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold"
                                                       TextWrapping="Wrap" Foreground="White"/>
                                            <TextBlock Text="{Binding Date}" FontSize="11"
                                                       Foreground="{StaticResource Text2Brush}" Margin="0,8,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>

                <!-- ─── Страница «Настройки» ─── -->
                <Grid Grid.Row="1" Margin="24,0,24,24"
                      Visibility="{Binding CurrentPage, Converter={StaticResource PageVis}, ConverterParameter=Settings}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="НАСТРОЙКИ" FontSize="20" FontWeight="Bold" Margin="0,0,0,16"/>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel MaxWidth="560" HorizontalAlignment="Left">

                            <!-- Игрок -->
                            <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="ИГРОК" FontSize="11" FontWeight="Bold"
                                               Foreground="{StaticResource Text2Brush}" Margin="0,0,0,12"/>
                                    <TextBlock Text="Никнейм" Foreground="{StaticResource Text2Brush}" FontSize="11" Margin="0,0,0,6"/>
                                    <TextBox Style="{StaticResource AuthTextBox}"
                                             Text="{Binding Nickname, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                            </Border>

                            <!-- Игра -->
                            <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="GTA V" FontSize="11" FontWeight="Bold"
                                               Foreground="{StaticResource Text2Brush}" Margin="0,0,0,12"/>

                                    <TextBlock Text="Папка игры" Foreground="{StaticResource Text2Brush}" FontSize="11" Margin="0,0,0,6"/>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Style="{StaticResource AuthTextBox}"
                                                 Text="{Binding GtaPath, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0"/>
                                        <Button Grid.Column="1" Content="Обзор…" Padding="14,8" Margin="0,0,6,0"
                                                Background="{StaticResource Bg2Brush}" Foreground="White" BorderThickness="0" Cursor="Hand"
                                                Command="{Binding BrowseGtaPathCommand}"/>
                                        <Button Grid.Column="2" Content="Автоопределить" Padding="14,8"
                                                Background="{StaticResource Bg2Brush}" Foreground="White" BorderThickness="0" Cursor="Hand"
                                                Command="{Binding DetectGtaCommand}"/>
                                    </Grid>

                                    <TextBlock Text="Версия клиента" Foreground="{StaticResource Text2Brush}" FontSize="11" Margin="0,0,0,6"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <Button Content="Legacy" Padding="18,8" Margin="0,0,8,0" Cursor="Hand" BorderThickness="0"
                                                Command="{Binding SetClientEditionCommand}" CommandParameter="Legacy">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Background" Value="{StaticResource Bg2Brush}"/>
                                                    <Setter Property="Foreground" Value="{StaticResource Text2Brush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsLegacyEdition}" Value="True">
                                                            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                                                            <Setter Property="Foreground" Value="White"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button Content="Enhanced" Padding="18,8" Cursor="Hand" BorderThickness="0"
                                                Command="{Binding SetClientEditionCommand}" CommandParameter="Enhanced">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Background" Value="{StaticResource Bg2Brush}"/>
                                                    <Setter Property="Foreground" Value="{StaticResource Text2Brush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsEnhancedEdition}" Value="True">
                                                            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                                                            <Setter Property="Foreground" Value="White"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </StackPanel>

                                    <TextBlock Text="{Binding StatusMessage}" FontSize="11" TextWrapping="Wrap"
                                               Foreground="{StaticResource Text2Brush}"/>
                                </StackPanel>
                            </Border>

                            <!-- Сервер -->
                            <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="СЕРВЕР" FontSize="11" FontWeight="Bold"
                                               Foreground="{StaticResource Text2Brush}" Margin="0,0,0,12"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="120"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                            <TextBlock Text="Адрес" Foreground="{StaticResource Text2Brush}" FontSize="11" Margin="0,0,0,6"/>
                                            <TextBox Style="{StaticResource AuthTextBox}"
                                                     Text="{Binding ServerHost, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Порт" Foreground="{StaticResource Text2Brush}" FontSize="11" Margin="0,0,0,6"/>
                                            <TextBox Style="{StaticResource AuthTextBox}"
                                                     Text="{Binding ServerPort, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Обновления -->
                            <Border Style="{StaticResource Card}" Padding="20">
                                <StackPanel>
                                    <TextBlock Text="ОБНОВЛЕНИЯ" FontSize="11" FontWeight="Bold"
                                               Foreground="{StaticResource Text2Brush}" Margin="0,0,0,12"/>
                                    <CheckBox Content="Обновлять FloV:MP автоматически" Foreground="White"
                                              IsChecked="{Binding AutoUpdate}"/>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>

            <!-- ═══════════════════════════════════════════════════════ -->
            <!-- ОВЕРЛЕЙ АВТОРИЗАЦИИ (Если игрок не вошёл)               -->
            <!-- ═══════════════════════════════════════════════════════ -->
            <Grid Grid.Column="0" Grid.ColumnSpan="2" 
                  Visibility="{Binding IsAuthenticated, Converter={StaticResource BoolToVisInverse}}">
                
                <!-- Затенение фона -->
                <Border Background="#D805050A"/>

                <!-- Окно логина -->
                <Border Width="400" Background="{StaticResource Bg0Brush}" 
                        BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1"
                        CornerRadius="12" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <StackPanel Margin="32">
                        
                        <!-- Лого и заголовок -->
                        <Image Source="../Assets/florida_logo.png" Width="48" Height="48" Margin="0,0,0,16"/>
                        <TextBlock Text="Держава RP" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                        <TextBlock Text="Войдите в аккаунт или зарегистрируйтесь" FontSize="12" Foreground="{StaticResource Text2Brush}" HorizontalAlignment="Center" Margin="0,0,0,24"/>

                        <!-- Инпуты -->
                        <TextBlock Text="Логин" Foreground="{StaticResource Text2Brush}" FontSize="11" Margin="0,0,0,4"/>
                        <TextBox Style="{StaticResource AuthTextBox}" Text="{Binding AuthLogin, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,16"/>

                        <TextBlock Text="Пароль" Foreground="{StaticResource Text2Brush}" FontSize="11" Margin="0,0,0,4"/>
                        <PasswordBox x:Name="PwBox" Style="{StaticResource AuthPasswordBox}" Margin="0,0,0,8" PasswordChanged="PwBox_PasswordChanged"/>

                        <!-- Ошибка -->
                        <TextBlock Text="{Binding AuthError}" Foreground="#FF6B6B" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,16"
                                   Visibility="{Binding HasAuthError, Converter={StaticResource BoolToVis}}"/>

                        <!-- Кнопки -->
                        <Button Style="{StaticResource PlayButton}" Content="{Binding AuthButtonText}" 
                                Command="{Binding LoginCommand}" Margin="0,0,0,12" Height="44"/>
                        
                        <Button Background="Transparent" Foreground="{StaticResource Text2Brush}" BorderThickness="0" Cursor="Hand"
                                Content="У меня ещё нет аккаунта" Command="{Binding ToggleRegisterModeCommand}"
                                Visibility="{Binding IsRegisterMode, Converter={StaticResource BoolToVisInverse}}"/>
                        <Button Background="Transparent" Foreground="{StaticResource Text2Brush}" BorderThickness="0" Cursor="Hand"
                                Content="У меня уже есть аккаунт" Command="{Binding ToggleRegisterModeCommand}"
                                Visibility="{Binding IsRegisterMode, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                </Border>
            </Grid>

        </Grid>
    </Border>
</Window>
