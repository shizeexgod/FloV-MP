<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Сервер лицензий FloV:MP: служба на VDS (ключи, активации, раздача пакетов)
    и её команды для владельца платформы — один исполняемый файл flovmp-license.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>flovmp-license</AssemblyName>
    <RootNamespace>FloVMP.LicenseAuthority</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MySqlConnector" Version="2.3.7" />
  </ItemGroup>

</Project>
