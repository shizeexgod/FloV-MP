<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Чистая гейм-логика без привязки к alt:V (AltV.Net не подключается).
    Отсюда её можно юнит-тестировать (FloVMP.Core.Tests). FloVMP.Starter
    ссылается на этот проект; dotnet publish кладёт FloVMP.Core.dll рядом
    со сборкой ресурса.
  -->
  <PropertyGroup>
    <AssemblyName>FloVMP.Core</AssemblyName>
    <RootNamespace>FloVMP.Core</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="MySqlConnector" Version="2.3.7" />
  </ItemGroup>

</Project>
