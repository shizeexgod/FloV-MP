<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===== Florida V Color Palette ===== -->
    <Color x:Key="AccentColor">#FF3D8A</Color>
    <Color x:Key="AccentHoverColor">#FF6EA8</Color>
    <Color x:Key="Bg0Color">#0A0A10</Color>
    <Color x:Key="Bg1Color">#12121E</Color>
    <Color x:Key="Bg2Color">#1A1A2E</Color>
    <Color x:Key="StrokeColor">#2A2A4A</Color>
    <Color x:Key="Text1Color">#FFFFFF</Color>
    <Color x:Key="Text2Color">#8888AA</Color>
    <Color x:Key="OnlineColor">#2ECC71</Color>
    <Color x:Key="OfflineColor">#E74C3C</Color>

    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}"/>
    <SolidColorBrush x:Key="Bg0Brush" Color="{StaticResource Bg0Color}"/>
    <SolidColorBrush x:Key="Bg1Brush" Color="{StaticResource Bg1Color}"/>
    <SolidColorBrush x:Key="Bg2Brush" Color="{StaticResource Bg2Color}"/>
    <SolidColorBrush x:Key="StrokeBrush" Color="{StaticResource StrokeColor}"/>
    <SolidColorBrush x:Key="Text1Brush" Color="{StaticResource Text1Color}"/>
    <SolidColorBrush x:Key="Text2Brush" Color="{StaticResource Text2Color}"/>
    <SolidColorBrush x:Key="OnlineBrush" Color="{StaticResource OnlineColor}"/>
    <SolidColorBrush x:Key="OfflineBrush" Color="{StaticResource OfflineColor}"/>

    <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#FF3D8A" Offset="0"/>
        <GradientStop Color="#FF6EA8" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="SidebarGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#0E0E1A" Offset="0"/>
        <GradientStop Color="#0A0A10" Offset="1"/>
    </LinearGradientBrush>

    <!-- Временный знак «Д» (плейсхолдер до реального лого «Держава Онлайн») -->
    <LinearGradientBrush x:Key="LogoMarkGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF7AB3" Offset="0"/>
        <GradientStop Color="#FF3D8A" Offset="0.55"/>
        <GradientStop Color="#C21E63" Offset="1"/>
    </LinearGradientBrush>

    <RadialGradientBrush x:Key="HeroGlowBrush" GradientOrigin="0.72,0.18" Center="0.72,0.18" RadiusX="0.65" RadiusY="0.9">
        <GradientStop Color="#29FF3D8A" Offset="0"/>
        <GradientStop Color="#00FF3D8A" Offset="1"/>
    </RadialGradientBrush>

</ResourceDictionary>
