# FloV:MP SaaS Portal — environment variables
# Copy to .env.local for local dev, or set in the Vercel project dashboard.
# If DB_* are unreachable the portal falls back to data/portal-db.json (dev only).

# ---- Database (MariaDB 10.6+ / MySQL 8) on the VDS ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=flovmp
DB_PASSWORD=change-me
DB_NAME=derzhava_rp

# ---- Auth ----
# openssl rand -hex 48
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# ---- License signing (HMAC-SHA256 of verify responses) ----
# openssl rand -hex 48
LICENSE_SIGNING_SECRET=change-me-to-a-long-random-string

# ---- RSA license authority (never commit the real private key) ----
# Store this in Vercel/secret-manager, not in .env files shipped to clients.
FLOVMP_AUTHORITY_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# ---- Public game node shown on the site ----
NEXT_PUBLIC_SERVER_HOST=127.0.0.1
NEXT_PUBLIC_SERVER_PORT=7788
NEXT_PUBLIC_PORTAL_URL=https://flovmp.ru

# ---- Optional: default SDK key used by examples ----
FLOVMP_KEY=
